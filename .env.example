# ── LLM 配置（OpenAI 兼容协议，切换提供商仅改以下三项） ─────────
# DeepSeek / Qwen / GPT / GLM / Claude 均可，只需修改 base_url 与 model
LLM_MODEL=deepseek-chat
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=sk-xxxx
LLM_TEMPERATURE=0.7
# 评分使用低温，保证结构化输出稳定
SCORING_TEMPERATURE=0.2
# 最大输出 token：评分 comment 可能较长，避免截断导致 JSON 不完整
LLM_MAX_TOKENS=4096

# ── 数据库（业务表 + LangGraph checkpointer 复用同一库） ─────────
# 支持 postgresql:// 或 postgresql+psycopg:// 两种写法
DATABASE_URL=postgresql://interview:interview@localhost:5432/interview
# LangGraph checkpointer 连接池大小（多线程并发面试各自检出独立连接；
# 池上限建议不低于 API 线程池并发数，默认 20 与 FastAPI 默认线程池 40 配合使用）
CHECKPOINTER_POOL_MIN_SIZE=1
CHECKPOINTER_POOL_MAX_SIZE=20

# ── 面试配置 ───────────────────────────────────────────────────
DEFAULT_MAX_FOLLOW_UPS=2
# MVP 兜底：置 true 时启动自动建表（默认走 alembic upgrade head）
AUTO_CREATE_TABLES=false

# ── 文件存储（面试录音等）─────────────────────────────────────────
# 上传文件落盘根目录（相对后端工作目录）。容器内 /app 已由 compose 绑定挂载到宿主机 backend/，
# 因此写到 /app/uploads 即持久化到 /home/ubuntu/hragent/backend/uploads（已被 .gitignore）
UPLOAD_DIR=uploads
# 单个面试录音大小上限（MB），超出直接拒绝
MAX_AUDIO_MB=50

# ── 对外链接 ───────────────────────────────────────────────────
# 候选人面试页基址（卡片/待办里的绝对链接由它拼出，形如 http://host:3000/i/{token}）。
# 部署到服务器或走内网穿透时，改成 HR / 候选人实际能打开的地址
PUBLIC_BASE_URL=http://localhost:3000

# ── 飞书 HR 通知（三类自动推送） ────────────────────────────────
# 总开关。true 且配置了 HR 收件人时，以下三类推送才会真正发出
FEISHU_NOTIFY_ENABLED=false
# ① AI 面试达标推送：综合分 >= 该值即推送（默认 65，与「推荐」档一致）
FEISHU_NOTIFY_THRESHOLD=65
# ② 简历初筛完成推送：把「推荐进入 AI 面试」的人以卡片推给 HR
FEISHU_SCREENING_NOTIFY_ENABLED=true
# 初筛推送门槛：初筛分 >= 该值才进入推荐名单
FEISHU_SCREENING_MIN_SCORE=65
# 初筛通过即自动生成 AI 面试链接（写进推送卡片与待办，可直接转发候选人）
FEISHU_SCREENING_AUTO_INVITE=true
# ③ 招聘汇总完成推送：提醒 HR 复核并办理 offer 发放 / 入职
FEISHU_SUMMARY_NOTIFY_ENABLED=true
# 单张卡片最多列出的候选人条数（超出只显示汇总数字，避免卡片过长）
FEISHU_NOTIFY_MAX_ITEMS=20
# 推送时顺带为 HR 创建飞书待办（任务），让「跟进」落到待办列表
FEISHU_TASK_ENABLED=true
# 待办负责人 open_id（ou_ 开头，逗号分隔）；留空 = 每个飞书收件人各建一条
FEISHU_TASK_ASSIGNEE_OPEN_IDS=
# 待办创建身份（仅 cli 传输生效）：bot=应用身份（服务器部署推荐，需应用申请 task:task:write）；
#                                user=本机登录用户身份（联调便捷，需给 lark-cli 补授权）
FEISHU_TASK_IDENTITY=bot
# 待办截止时间（天数，相对今天）
FEISHU_TASK_DUE_DAYS=2
# 传输方式：cli=复用本机已登录的 lark-cli（默认，适合本机联调，无需密钥）；
#           api=飞书 Open API 直连（部署到服务器/容器必须用这个，
#           不依赖 lark-cli / node / macOS keychain）
FEISHU_NOTIFY_TRANSPORT=cli
# HR 收件人 open_id（ou_ 开头），多个用英文逗号分隔
FEISHU_HR_OPEN_IDS=
# HR 收件部门（open_department_id，od- 开头），多个用英文逗号分隔；
# 推送时按部门实时解析在职成员（自动纳入新入职、过滤离职/冻结）——适合"整个 HR 部门都收到"
FEISHU_HR_DEPARTMENT_IDS=
# cli 传输：lark-cli 可执行文件路径（留空则自动探测；launchd 下建议显式指定）
FEISHU_LARK_CLI_PATH=
# api 传输：自建应用凭据（FEISHU_NOTIFY_TRANSPORT=api 时必填）
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# 单次发送超时（秒）。cli 传输首次调用（lark-cli 冷启动）较慢，建议 20
FEISHU_NOTIFY_TIMEOUT=20

# ── 长连接（卡片按钮回调）────────────────────────────────
# 开启后审批人可直接在飞书卡片上点「同意 / 驳回」完成审批：
# 走飞书 SDK 长连接（WebSocket）接收回调，**无需公网 HTTPS 域名**。
# 前置条件（缺一不可）：
#   1) 开发者后台「事件订阅」选择「使用长连接接收回调」；
#   2) 订阅 card.action.trigger（卡片回传交互）；
#   3) 应用为**企业自建应用**（个人应用不支持长连接）。
FEISHU_LONGCONN_ENABLED=false

# ── Offer → 入职闭环（第⑤阶段：汇总之后 → 发 Offer → 候选人确认 → 入职）──
# 状态卡片推送总开关（关闭后所有 Offer 通知静默，业务主流程不受影响）
FEISHU_OFFER_NOTIFY_ENABLED=true
# 发起 Offer 的最低最终加权分门槛（低于该值不允许发起，对齐「推荐」档）
OFFER_MIN_FINAL_SCORE=65
# 候选人确认截止：发出后「次日本地 HH:00」（默认次日 08:00）
OFFER_CONFIRM_HOUR=8
# 截止时间所用本地时区偏移（小时）；8 = 北京时间（UTC+8）
OFFER_CONFIRM_TZ_OFFSET=8
# 【上线必填】Offer 审批人 open_id（ou_ 开头，逗号分隔）——线上应填**老板**；
# 留空时「提交审批」返回 422（审批流必须有明确收件人）
OFFER_APPROVER_OPEN_IDS=
# 店长收件人 open_id（候选人接受后同步通知；留空则只通知 HR）
FEISHU_STORE_MANAGER_OPEN_IDS=
# 老板收件人 open_id（ou_ 开头，逗号分隔）：候选人进入「待终试」时推送老板，
# 由老板在操作台确认终面时间并拍板。留空则不发终试推送（不影响其余通知）
FEISHU_BOSS_OPEN_IDS=
# 进入「待终试」是否自动推送老板（默认开；留空如需关闭填 false）
FEISHU_FINAL_PENDING_NOTIFY_ENABLED=true
# 老板确认 / 改期 / 取消终面时间后是否推送 HR（默认开）
FEISHU_FINAL_SCHEDULED_NOTIFY_ENABLED=true
# 老板终试点「通过」后是否推送 HR（默认开）：
# 终试通过是 HR 发起 Offer 的唯一前置条件，不推 HR 只能自己刷「数据汇总」页
FEISHU_FINAL_PASSED_NOTIFY_ENABLED=true
# 全局抄送人 open_id（逗号分隔）：**所有**走默认收件人的飞书卡片都会额外发给这些人。
# 注意：推老板的「待终试」卡片是定向发送，**不会**抄送（避免老板关卡的消息外溢）。
FEISHU_OBSERVER_OPEN_IDS=
# 候选人确认页展示的 HR 联系电话（候选人放弃线上确认时走线下兜底）
HR_CONTACT_PHONE=

# ── 后台登录鉴权（账号密码 + 服务端会话）──────────────────────
# 账号由管理员创建，**系统不开放自助注册**：
#   python backend/scripts/create_admin.py create --username hr01 --role admin
# 会话有效期（小时）。12 = 上班登录一次，当天下班后失效
AUTH_SESSION_HOURS=12
# Cookie 是否带 Secure 标记。**仅在 HTTPS 下置 true** ——
# HTTP 部署置 true 会让浏览器不回传 Cookie，表现为「登录成功后立刻掉线」
AUTH_COOKIE_SECURE=false
# Cookie Domain，留空表示当前域名（同域部署无需设置）
AUTH_COOKIE_DOMAIN=
# 连续失败多少次触发账号锁定；首次锁定 15 分钟，之后按 2 的幂指数退避（封顶 24 小时）
AUTH_LOGIN_MAX_FAILURES=5
AUTH_LOGIN_LOCK_MINUTES=15
# IP 维度登录限流：窗口（秒）内允许的失败次数上限
AUTH_LOGIN_RATE_WINDOW_SECONDS=900
AUTH_LOGIN_RATE_MAX_ATTEMPTS=10

# 【按需填写】外部系统读取评分接口（/api/scores/*）的密钥，请求头 X-API-Key 携带。
# 留空 = 该接口一律拒绝（503，安全默认）。生成：openssl rand -hex 32
SCORES_API_KEY=
# 允许的跨域来源白名单（逗号分隔）。同域部署留空即可；**禁止填 "*"**
CORS_ALLOW_ORIGINS=
# 安全响应头与 CSP：生产 CSP 由 nginx 下发；本机 Vite dev 有内联脚本，CSP 需关闭
SECURITY_HEADERS_ENABLED=true
SECURITY_CSP_ENABLED=false
# 是否开放 /docs /redoc /openapi.json（会摊开全部接口结构，生产建议 false）
ENABLE_API_DOCS=true

# ── 候选人邮件（Offer 通知 / 接受确认）─────────────────────────
# 总开关：false 或未配 SMTP 时所有候选人邮件静默跳过，不影响审批与接受主流程
CANDIDATE_MAIL_ENABLED=false
# 发件 SMTP：飞书企业邮箱 smtp.feishu.cn:465（SSL，推荐）/ 587（STARTTLS）
# 额度：800 封/天、外部收件人 500 封/天（手动+自动共享），
#       SMTP 频率 200 封/100 秒，每日北京时间 08:00 重置
SMTP_HOST=smtp.feishu.cn
SMTP_PORT=465
SMTP_USE_SSL=true
# 发件邮箱：必须与 SMTP 登录账号同域，否则服务商拒绝伪造发件人
SMTP_USERNAME=hr@example.com
# 客户端专用密码（飞书「设置→第三方客户端」生成，非网页登录密码）
SMTP_PASSWORD=
# 发件人显示名（候选人收件箱里看到的名字）
MAIL_FROM_NAME=昆明笨二娘餐饮管理有限公司人事行政
# 主题/落款公司名（与显示名解耦；留空回退到 MAIL_FROM_NAME）
MAIL_COMPANY_NAME=
# 候选人直接回复的收件地址（留空 = 等于发件邮箱）
MAIL_REPLY_TO=
# 单封发送超时（秒）
SMTP_TIMEOUT=15
